# Kurultai environment variables (root / daemon / CLI).
# Copy to `.env` for local tooling if desired, or export in your shell.
# Config file keys live in config.example.toml → ~/.config/kurultai/config.toml
#
# Never commit real secrets. API keys must not appear in config.toml.

# --- OpenRouter (one key → embed + rerank + LLM ask) -----------------------
# Get a key at https://openrouter.ai/keys
# Prefer OPENROUTER_API_KEY; KURULTAI_API_KEY is accepted as an alias.
#
# With the key set:
#   • Embeddings  → openai/text-embedding-3-large  ([embed] in config.example.toml)
#   • Rerank      → openai/gpt-4o-mini             ([runtime] reranker_model)
#   • LLM ask     → openai/gpt-4o-mini             (default when key is set)
#
# FTS search works without a key. Vectors, rerank, and LLM ask need it.
OPENROUTER_API_KEY=
# KURULTAI_API_KEY=

# --- Runtime overrides -------------------------------------------------------
# Deployment environment: dev | staging | prod (overrides config `environment`)
# KURULTAI_ENV=dev

# Absolute path to config.toml (default: ~/.config/kurultai/config.toml)
# KURULTAI_CONFIG=

# Log filter (e.g. kurultai=debug,info). Also used by the daemon.
# KURULTAI_LOG=kurultai=info

# Force plain CLI output (no banner art). Also: --plain, NO_COLOR.
# KURULTAI_PLAIN=1
# NO_COLOR=1

# Shared secret for daemon MCP HTTP/SSE (POST /mcp, GET /mcp/sse).
# Prefer this over [runtime] mcp_http_secret in config.toml.
# KURULTAI_MCP_HTTP_SECRET=

# Shared secret for loopback dump ingest (POST /ingest). Required to enable the route.
# Peer must be loopback; constant-time compare. Not under /api/.
# KURULTAI_INGEST_SECRET=

# --- Hub (HUB-3; product flag default off) -----------------------------------
# See docs/deploy/railway-hub.md. Solo loopback + SQLite is unchanged without these.
# KURULTAI_FEATURE_HUB=1
# DATABASE_URL=postgres://user:pass@host:5432/kurultai
# KURULTAI_DATABASE_URL=
# KURULTAI_HUB_BIND=all
# KURULTAI_HUB_LISTEN=
# KURULTAI_HUB_AUTH=api_key
# KURULTAI_HUB_API_KEYS=
# ALLOW_PUBLIC_HUB=0
# KURULTAI_PUBLIC_HOSTNAME=
# PORT=8421

# --- Frontend apps (separate examples) ---------------------------------------
# web/     → see web/.env.example (Clerk)
# website/ → Vite marketing site (no secrets required for local preview)
