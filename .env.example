# Kurultai environment variables. Copy to `.env` (docker compose reads it
# automatically) or export in your shell. Every variable is optional unless
# marked REQUIRED. Never commit real secrets. API keys never go in config.toml.
# Config-file settings live in config.example.toml (~/.config/kurultai/config.toml).

# ============================================================================
# Self-host quick start (docker-compose.yml)
# ============================================================================
# Image tag to run (default: latest). Pin a release, e.g. v0.7.1.
# KURULTAI_TAG=latest
# Host port published on 127.0.0.1.
# KURULTAI_PORT=8421
# Host folder of Markdown notes to import (uncomment the volume in docker-compose.yml).
# KURULTAI_NOTES=./notes
# KURULTAI_SELFHOST=1           # set by docker-compose.yml: first-run config + access key
# KURULTAI_NOTES_DIR=/data/notes  # where the self-host bootstrap points [sources.notes]

# ============================================================================
# Embeddings: pick ONE (search by meaning). With none of these, search is
# keyword-only (FTS5), which needs no setup and is perfectly usable.
# The store's vector size is fixed at first index; changing embedder later
# means a fresh store (new volume / storage.path).
# ============================================================================
# KURULTAI_EMBED_BACKEND=local | openrouter | perplexity
#   local       on-device ONNX (needs the local-embed build, see
#               docker-compose.local-embed.yml); defaults to AllMiniLML6V2, 384 dims
#   openrouter  cloud; uses OPENROUTER_API_KEY below
#   perplexity  cloud; uses PERPLEXITY_API_KEY below
# KURULTAI_EMBED_BACKEND=
# KURULTAI_EMBED_MODEL=         # override the model for the chosen backend
# KURULTAI_EMBED_DIM=           # must match the model's output size

# --- OpenRouter (one key: embeddings + rerank + LLM ask) --------------------
# Key or `kurultai connect openrouter`. Create at https://openrouter.ai/keys
# (OpenRouter now requires keys to have an expiration date).
# KURULTAI_API_KEY is accepted as an alias.
OPENROUTER_API_KEY=
# KURULTAI_API_KEY=
# KURULTAI_API_KEY_FILE=        # read the key from this file instead (containers/secrets)

# --- Perplexity (embeddings via pplx-embed, ask --web augmentation) ---------
# PERPLEXITY_API_KEY=
# KURULTAI_FEATURE_WEB_SEARCH=1   # ephemeral web context for `kurultai ask --web`

# ============================================================================
# Runtime
# ============================================================================
# Deployment environment: dev | staging | prod (picks the default store path)
# KURULTAI_ENV=dev
# Absolute path to config.toml (default: ~/.config/kurultai/config.toml)
# KURULTAI_CONFIG=
# Log filter, e.g. kurultai=debug,info (also RUST_LOG for the container)
# KURULTAI_LOG=kurultai=info
# Force plain CLI output (no banner art). Also: --plain, NO_COLOR.
# KURULTAI_PLAIN=1
# NO_COLOR=1
# SQLite busy timeout for multi-process access (milliseconds)
# KURULTAI_SQLITE_BUSY_TIMEOUT_MS=
# Daemon port (default 8421)
# PORT=8421

# ============================================================================
# Network exposure and auth (daemon)
# ============================================================================
# Loopback is the default and needs no auth. A non-loopback bind is refused
# unless auth is configured. Self-host mode mints an access key for you.
# KURULTAI_HUB_BIND=all             # all | tailscale; unset = 127.0.0.1
# KURULTAI_HUB_LISTEN=              # explicit listen address
# KURULTAI_HUB_AUTH=api_key
# KURULTAI_HUB_API_KEYS=            # comma-separated bearer keys
# Cloudflare Access JWT auth for human browser logins (alternative to keys)
# KURULTAI_CF_ACCESS_TEAM=
# KURULTAI_CF_ACCESS_AUDS=
# Emails allowed to approve devices / use the Hey admin lane (comma-separated)
# KURULTAI_ADMIN_EMAILS=
# Token required for write routes under the shared-write policy
# KURULTAI_ADMIN_TOKEN=
# Public hostname behind a proxy (used for device-approval URLs)
# KURULTAI_PUBLIC_HOSTNAME=

# ============================================================================
# Agents and ingestion
# ============================================================================
# Shared secret for MCP over HTTP/SSE (POST /mcp, GET /mcp/sse). Read-only scope.
# KURULTAI_MCP_HTTP_SECRET=
# Shared secret for POST /ingest (route is disabled until this is set)
# KURULTAI_INGEST_SECRET=
# KURULTAI_FEATURE_REMOTE_INGEST=1  # accept /ingest from non-loopback callers
# Agent identity stamped on writes
# KURULTAI_AGENT_ID=
# KURULTAI_INSTANCE_ID=
# KURULTAI_NAMESPACE=
# KURULTAI_PROJECT=

# ============================================================================
# Team hub (optional; Postgres + pgvector). See docs/deploy/railway-hub.md.
# ============================================================================
# KURULTAI_FEATURE_HUB=1
# DATABASE_URL=postgres://user:pass@host:5432/kurultai
# KURULTAI_DATABASE_URL=
# ALLOW_PUBLIC_HUB=0

# ============================================================================
# Frontend apps (separate examples)
# ============================================================================
# web/     -> see web/.env.example (Clerk)
# website/ -> Vite marketing site (no secrets needed for local preview)
