{
  "name": "kurultai-brain-ui-source",
  "version": "0.6.0",
  "private": true,
  "description": "React + Three.js brain UI source. Build outputs to ui/ for Rust embedding.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
