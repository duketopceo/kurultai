# Copy to .env and fill in real values.
# The .env file is gitignored and lives on server-001.

CF_ACCOUNT_ID=1661907b2d7e4a20800306e6a57844c5
CF_TUNNEL_ID=16ff6454-f890-40ab-ae8d-3632ed23ee2d
CF_ZONE_NAME=shippedit.dev

# Cloudflare connector token for cloudflared (Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Cloudflare API token with Zone:Edit and Cloudflare Tunnel:Edit
# Used once to add DNS + tunnel ingress, then should be removed.
CLOUDFLARE_API_TOKEN=your_api_token_here

# Instance API keys and MCP/ingest secrets (regenerate with regen-secrets.sh)
PERSONAL_API_KEYS=your_64_char_hex_key
WORK_API_KEYS=your_64_char_hex_key
PERSONAL_MCP_SECRET=your_64_char_hex_secret
WORK_MCP_SECRET=your_64_char_hex_secret
PERSONAL_INGEST_SECRET=your_64_char_hex_secret
WORK_INGEST_SECRET=your_64_char_hex_secret

# --- Hub (Postgres shared brain) ------------------------------------------
# Required once the kurultai-hub / kurultai-hub-db services exist in compose —
# the `:?` guards make every compose command fail until these are set.
# Generate secrets with `openssl rand -hex 32`.

# Runtime role password (kurultai_app, non-owner — RLS applies). Compose-internal DSN.
KURULTAI_HUB_DB_PASSWORD=your_64_char_hex_secret
# Migrate role password (kurultai_migrate, BYPASSRLS) — schema migrations + `kurultai hub …` CLI.
KURULTAI_HUB_MIGRATE_DB_PASSWORD=your_64_char_hex_secret
# Postgres superuser password for the kurultai-hub-db container (bootstrap only).
KURULTAI_HUB_DB_SUPERPASSWORD=your_64_char_hex_secret
# Comma-separated admin emails — /connect approver gate (CF Access identity must match).
KURULTAI_ADMIN_EMAILS=admin@example.com
# AUD tag(s) of the admin-scoped Cloudflare Access application for the hub hostnames
# (hub.shippedit.dev interactive admin gate; api-hub.shippedit.dev stays bearer-only).
HUB_CF_ACCESS_AUDS=your_access_app_aud_tag
