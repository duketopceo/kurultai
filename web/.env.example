# Clerk — https://dashboard.clerk.com
# 1. Create an application
# 2. User & Authentication → Social connections → enable GitHub
# 3. Disable public sign-up (admin console is invite-only)
# 4. Copy keys below

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Hub admin console (server-side only — NEVER NEXT_PUBLIC_*) ────────
# Base URL of the hub daemon's HTTP admin surface (hub mode + Postgres).
KURULTAI_HUB_API_URL=https://api-hub.shippedit.dev

# An `is_admin` hub key — mint once with:
#   kurultai hub key issue --agent web-admin --team ops --admin
# HUB_ADMIN_KEY is accepted as a fallback name.
KURULTAI_ADMIN_KEY=krt_...

# Comma-separated Clerk account emails allowed into /dashboard/*.
# Unset or empty = nobody is admin (fail closed). A Clerk user with
# publicMetadata.role = "admin" also passes.
WEB_ADMIN_EMAILS=you@example.com,other-admin@example.com
